pipeline
{
    agent any
    stages
    {
        stage('Download')
        {
            steps
            {
               git branch: 'main', url: 'https://github.com/Mamaliprusty/JAVA-WEBAPPLICATION.git'
            }
        }
         stage('Build')
        {
            steps
            {
                sh 'mvn clean package'
        
            }
        }
    
    }
}


    
    
